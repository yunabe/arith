// Renders the Mandelbrot set as ASCII art: nested loops, f64 arithmetic,
// and building each row by string concatenation (Arith has no arrays yet).
// A point c is in the set when z = z*z + c stays bounded; the escape
// iteration count picks the character.
fn shade(iterations: i64, limit: i64) -> string {
    if iterations >= limit {
        return "@";
    }
    if iterations >= 16 {
        return "#";
    }
    if iterations >= 8 {
        return "+";
    }
    if iterations >= 4 {
        return ".";
    }
    return " ";
}

fn escape_count(cr: f64, ci: f64, limit: i64) -> i64 {
    let zr = 0.0;
    let zi = 0.0;
    let count = 0;
    while count < limit && zr * zr + zi * zi <= 4.0 {
        let next_zr = zr * zr - zi * zi + cr;
        zi = 2.0 * zr * zi + ci;
        zr = next_zr;
        count += 1;
    }
    return count;
}

fn main() {
    let width = 72;
    let height = 24;
    let limit = 32;
    for y in 0..height {
        let row = "";
        let ci = -1.2 + 2.4 * f64(y) / f64(height - 1);
        for x in 0..width {
            let cr = -2.1 + 3.0 * f64(x) / f64(width - 1);
            row += shade(escape_count(cr, ci, limit), limit);
        }
        print(row);
    }
}
