// Conway's Game of Life on a finite board. The two-dimensional board is a
// jagged [][]bool array. A repeated row would alias, so make_grid replaces
// every slot with a fresh row before the board is used.
fn make_grid(width: i64, height: i64) -> [][]bool {
    let grid = [[false; width]; height];
    for y in 0..height {
        grid[y] = [false; width];
    }
    return grid;
}

fn neighbor_count(grid: [][]bool, x: i64, y: i64) -> i64 {
    let height = len(grid);
    let width = len(grid[0]);
    let count = 0;
    for dy in -1..=1 {
        for dx in -1..=1 {
            if dx != 0 || dy != 0 {
                let nx = x + dx;
                let ny = y + dy;
                if nx >= 0 && nx < width && ny >= 0 && ny < height && grid[ny][nx] {
                    count += 1;
                }
            }
        }
    }
    return count;
}

fn next_generation(grid: [][]bool) -> [][]bool {
    let height = len(grid);
    let width = len(grid[0]);
    let next = make_grid(width, height);
    for y in 0..height {
        for x in 0..width {
            let neighbors = neighbor_count(grid, x, y);
            next[y][x] = neighbors == 3 || (grid[y][x] && neighbors == 2);
        }
    }
    return next;
}

fn print_grid(grid: [][]bool) {
    for cells in grid {
        let row = "";
        for alive in cells {
            if alive {
                row += "#";
            } else {
                row += ".";
            }
        }
        print(row);
    }
}

fn population(grid: [][]bool) -> i64 {
    let count = 0;
    for row in grid {
        for alive in row {
            if alive {
                count += 1;
            }
        }
    }
    return count;
}

fn main() {
    let grid = make_grid(8, 8);

    // A glider moves one cell down and right every four generations.
    grid[1][2] = true;
    grid[2][3] = true;
    grid[3][1] = true;
    grid[3][2] = true;
    grid[3][3] = true;

    for generation in 0..=4 {
        print(f"generation ${generation}");
        print_grid(grid);
        if generation < 4 {
            grid = next_generation(grid);
        }
    }
    print(f"population after 4 generations = ${population(grid)}");
}
