// Recursive factorial. Arith integer arithmetic is checked (spec section 11),
// so factorial(21) does not wrap around to a wrong answer the way it would in
// most languages: the multiplication overflows i64 and the program faults.
// Try 20 (the largest factorial an i64 can hold), then 21.
fn factorial(n: i64) -> i64 {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

fn main(n: i64) {
    print(string(n) + "! = " + string(factorial(n)));
}
