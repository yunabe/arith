// Sums 1..n with an accumulator-passing tail call. Arith's emitter does not
// use the IL `tail.` prefix, so whether deep recursion survives depends on
// whether the JIT applies its implicit tail-call optimization. Probe it:
//
//   arith run tailsum.arith 100000000
//
// See examples/README.md for what to expect.
fn sum(n: i64, acc: i64) -> i64 {
    if n == 0 {
        return acc;
    }
    return sum(n - 1, acc + n);
}

fn main(n: i64) {
    print("sum(1..=" + string(n) + ") = " + string(sum(n, 0)));
}
