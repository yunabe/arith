// A tiny command-line calculator: the first argument picks the operation,
// the remaining arguments are the operands. Shows `main(args: []string)`,
// string-to-integer conversions, and interpolated strings.
fn apply(op: string, acc: i64, value: i64) -> i64 {
    if op == "prod" {
        return acc * value;
    }
    if op == "max" {
        if value > acc {
            return value;
        }
        return acc;
    }
    return acc + value; // sum
}

fn main(args: []string) -> i32 {
    if len(args) < 2 {
        print("usage: calc <sum|prod|max> <number> [numbers...]");
        return 2;
    }

    let op = args[0];
    if op != "sum" && op != "prod" && op != "max" {
        print(f"unknown operation: ${op}");
        return 2;
    }

    // The first operand seeds the accumulator, so prod and max need no
    // identity element. i64(...) makes a bad operand a runtime error.
    let acc = i64(args[1]);
    for i in 2..len(args) {
        acc = apply(op, acc, i64(args[i]));
    }

    print(f"${op} of ${len(args) - 1} numbers = ${acc}");
    return 0;
}
